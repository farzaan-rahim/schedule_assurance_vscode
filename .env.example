# Local development example; supply your own password. No production secrets belong here.
SA_DATABASE_URL=postgresql+psycopg://schedule_assurance:change-me-local-only@127.0.0.1:5433/schedule_assurance
SA_STORAGE_ROOT=./var/source-files
SA_MAXIMUM_UPLOAD_BYTES=104857600
# Docker Compose reads these variables independently of application settings.
POSTGRES_USER=schedule_assurance
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=schedule_assurance
POSTGRES_PORT=5433
# Explicit disposable PostgreSQL database only; never point tests at production.
# POSTGRES_TEST_DATABASE_URL=postgresql+psycopg://user:password@127.0.0.1:5433/disposable_test_database
