# Local DEVELOPMENT EXAMPLE ONLY. Copy to .env and replace the placeholder password.
# Keep the application URL and Docker credentials consistent. Do not commit .env.
SA_DATABASE_URL=postgresql+psycopg://schedule_assurance:change-me-local-only@127.0.0.1:5433/schedule_assurance
SA_STORAGE_ROOT=./var/source-files
SA_MAXIMUM_UPLOAD_BYTES=104857600
# Docker Compose local development settings (PostgreSQL listens on host port 5433).
POSTGRES_USER=schedule_assurance
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=schedule_assurance
POSTGRES_PORT=5433
# Native PostgreSQL alternative: use the ACTUAL existing database role and port.
# SA_DATABASE_URL=postgresql+psycopg://schedule_user:schedule_password@localhost:5432/schedule_assurance
# Tests require a separately configured DISPOSABLE database, never a production URL.
# POSTGRES_TEST_DATABASE_URL=postgresql+psycopg://test_user:test_password@127.0.0.1:5433/disposable_test_database
